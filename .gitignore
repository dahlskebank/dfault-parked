# ============================================================
#  .gitignore for the D-FAULT PARKED landing page (plain PHP)
# ============================================================

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Editor files
*.swp
*.swo

# VS Code — share settings.json/extensions.json, ignore everything else
# (tasks.json/launch.json tend to accumulate machine-specific paths)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Environment variables / secrets
.env
.env.*
!.env.example

# Temp/scratch files
_temp/

# Claude Code local settings
.claude/
